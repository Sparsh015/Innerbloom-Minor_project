# Frontend environment variables (copy to .env for local development)
# URL of the FastAPI backend (Render URL in production, e.g. https://innerbloom-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# How often automatic facial check-ins run while the dashboard is open.
# Defaults to 600000 (10 minutes). Values below 5000 are clamped.
VITE_FACIAL_AUTO_CHECK_INTERVAL_MS=600000

# WebRTC (video calls): STUN is used by default. For users on different networks/NAT,
# configure a TURN server (recommended) via env vars below. Do not hardcode credentials.
# Option A: JSON array of RTCIceServer objects
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp"],"username":"USER","credential":"PASS"}]
# Option B: add TURN to default STUN servers
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
