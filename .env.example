# Frontend environment variables (copy to .env for local development)
# URL of the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000

# How often automatic facial check-ins run while the dashboard is open.
# Defaults to 600000 (10 minutes). Values below 5000 are clamped.
VITE_FACIAL_AUTO_CHECK_INTERVAL_MS=600000
